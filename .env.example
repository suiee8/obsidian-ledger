# Copy to .env. The API reads LEDGER_* from the environment.
# Trade data never leaves this machine. There is no telemetry key.

LEDGER_HOST=127.0.0.1
LEDGER_PORT=8000
LEDGER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Browser origin talks only to the local API.
VITE_API_URL=http://127.0.0.1:8000
