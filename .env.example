# Put API settings in api/.env and Vite settings in web/.env.
# pnpm dev uses fixed listener ports. See docs/user-guide.md for details.
# The journal is stored locally. Optional AI sharing is configured in the app.

LEDGER_HOST=127.0.0.1
LEDGER_PORT=8000
LEDGER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Browser origin talks only to the local API.
VITE_API_URL=http://127.0.0.1:8000
